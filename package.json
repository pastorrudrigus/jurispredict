  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "coletor:build": "tsc src/lib/coletores/whatsapp.ts src/lib/extracao.ts src/lib/pitch.ts src/lib/classe.ts src/lib/datajud/cliente.ts src/lib/datajud/consultas.ts src/lib/datajud/partes.ts src/lib/datajud/classificador.ts --outDir .tmp-cli --module commonjs --target es2020 --esModuleInterop --skipLibCheck",
    "coletor:testar": "npm run coletor:build --silent && node scripts/testar-coletor.cjs",
    "motor:testar": "npm run coletor:build --silent && node scripts/testar-motor.cjs",
    "datajud:testar": "npm run coletor:build --silent && node scripts/testar-datajud.cjs",
    "classificador:testar": "npm run coletor:build --silent && node scripts/testar-classificador.cjs",
    "partes:testar": "npm run coletor:build --silent && node scripts/testar-partes.cjs",
    "demo:leads": "npm run coletor:build --silent && node scripts/demo-leads.cjs",
    "migrations:juntar": "./scripts/juntar-migrations.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^14.2.35",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  }
}
