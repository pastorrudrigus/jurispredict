# ---------------------------------------------------------------- Supabase --
# Settings > API no painel do Supabase.

# URL do projeto. Pode ser exposta ao browser.
NEXT_PUBLIC_SUPABASE_URL=
# anon/publishable key. É PARA ser pública — quem protege os dados é o RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role. IGNORA RLS. Só é usada em caminhos que já checaram exigirAdmin()
# (ingestão e cron). NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=

# Opcional: só é lida se NEXT_PUBLIC_SUPABASE_URL não estiver definida.
SUPABASE_URL=

# --------------------------------------------------------------- Anthropic --
# https://console.anthropic.com — usada na extração dos anúncios (server-side).
ANTHROPIC_API_KEY=

# ----------------------------------------------------- P1: DataJud (opcional) --
# Chave pública da API do DataJud, publicada na wiki do CNJ.
# Sem ela, /api/cron/datajud responde 503 e o card de estatística some do painel.
DATAJUD_API_KEY=
# Protege /api/cron/datajud (rota fora do middleware de sessão). O cron da
# Vercel envia automaticamente `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
# Código IBGE do município filtrado no DataJud. Padrão: Goiânia (5208707).
# Deixe vazio para não filtrar por município.
DATAJUD_MUNICIPIO_IBGE=
