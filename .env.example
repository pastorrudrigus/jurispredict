# Supabase — projeto criado em https://supabase.com
SUPABASE_URL=
# service_role key. NUNCA prefixar com NEXT_PUBLIC_. Usada só em server actions / route handlers.
SUPABASE_SERVICE_KEY=

# https://console.anthropic.com
ANTHROPIC_API_KEY=

# senha única do painel (middleware). Use algo longo e aleatório.
ADMIN_PASSWORD=

# P1 (opcional) — chave pública da API do DataJud, publicada na wiki do CNJ.
# Sem ela, /api/cron/datajud responde 503 e o card de estatística some do painel.
DATAJUD_API_KEY=
# Protege /api/cron/datajud (rota fora do middleware de senha). O cron da Vercel
# envia automaticamente `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
# Código IBGE do município filtrado no DataJud. Padrão: Goiânia (5208707).
# Deixe vazio para não filtrar por município.
DATAJUD_MUNICIPIO_IBGE=
